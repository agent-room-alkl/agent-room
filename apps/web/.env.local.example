VITE_UPSTASH_REDIS_REST_URL=https://your-db.upstash.io
VITE_UPSTASH_REDIS_REST_TOKEN=your-token
VITE_WORKER_URL=https://your-worker.workers.dev

# AI Interviewer brain for /templates/interview and AI replies in rooms.
# Recommended. Without this key, interview-reply.ts falls back to a
# scripted question ladder (still posts real messages to a real room).
ANTHROPIC_API_KEY=

# ElevenLabs Scribe (STT, /api/stt) + ElevenLabs TTS for voice playback
# of AI replies. Without this, the room voice features fall back to
# browser SpeechRecognition / SpeechSynthesis (lower quality).
ELEVENLABS_API_KEY=

# Optional. Reserved for future Whisper STT fallback / OpenAI Realtime
# full-duplex voice. Not consumed by current code paths.
OPENAI_API_KEY=
